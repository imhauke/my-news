# Copy this file to backend/.env and fill it in. Never commit backend/.env.

# --- Database ---
POSTGRES_USER=mynews
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mynews
# Outside Docker Compose (e.g. running pytest or uvicorn locally):
# DATABASE_URL=postgresql+asyncpg://mynews:change-me@localhost:5432/mynews

# --- App ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Set to true when served over HTTPS (session cookie)
COOKIE_SECURE=false
# Interactive API docs (/docs, /redoc) and /openapi.json. Turn off in production.
# API_DOCS=false
# How often (minutes) the worker refreshes sources, enrichment and live HN threads
# REFRESH_MINUTES=5
# Disable the worker's scheduler (useful while developing)
# SCHEDULER_ENABLED=false

# --- Production (infra/docker-compose.prod.yml) ---
DOMAIN=mynews.example.com

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Models per task; they change often, so they are configurable.
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Own per-model limits (requests per minute / per day). 0 = unlimited: on a 429 from Google
# the client retries with exponential backoff. Set them if your project has low quotas.
GEMINI_RPM=0
GEMINI_RPD=0

# --- Manual deploy scripts (scripts/deploy.sh, run on your machine) ---
MN_HOST=user@your-vps
MN_REMOTE=/opt/mynews
