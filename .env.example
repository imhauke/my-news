# Copia este fichero a backend/.env y rellénalo. Nunca subas backend/.env al repositorio.

# --- Base de datos ---
POSTGRES_USER=mynews
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mynews
# Fuera de Docker Compose (p. ej. pytest o uvicorn en local):
# DATABASE_URL=postgresql+asyncpg://mynews:change-me@localhost:5432/mynews

# --- App ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Desactiva el planificador del worker (útil en desarrollo)
# SCHEDULER_ENABLED=false

# --- Prod (infra/docker-compose.prod.yml) ---
DOMAIN=mynews.example.com

# --- Gemini (free tier, Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Modelos por tarea: cambian a menudo, por eso son configurables.
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Límites propios por modelo (peticiones/minuto y /día). 0 = sin límite: ante un 429 de Google
# se reintenta con espera exponencial. Ponlos si tu proyecto de AI Studio tiene cuotas bajas.
GEMINI_RPM=0
GEMINI_RPD=0

# --- Despliegue (scripts/deploy.sh; corre en tu máquina) ---
MN_HOST=user@your-vps
MN_REMOTE=/opt/mynews
